<div id="background">
  <div id="page">
    {{> header }}
    <div id="contents">
      <div class="box">
        <div>
          <div class="body">
            <h1>Travel</h1>
            {{#if error}}
            <p class="error-message">{{error}}</p>
            {{/if}}
            <ul id="sites">
              {{#each trips}}
              <li>
                <a href="/api/trips/{{this.code}}"><img alt="{{this.name}}" src="/images/{{this.image}}" /></a>
                <h2><a href="/api/trips/{{this.code}}">{{this.name}}</a></h2>
                {{{this.description}}}
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
    {{> footer }}
  </div>
</div>
